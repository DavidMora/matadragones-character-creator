<section class="mcc-tab mcc-builder">
  <div class="mcc-concept">
    <h3>{{localize 'MCC.Concept.Heading'}}
      <i class="fa-solid fa-circle-info" data-tooltip="{{localize 'MCC.Concept.Tooltip'}}"></i>
    </h3>
    <div class="mcc-row">
      <label class="mcc-field mcc-field-wide">
        <span>{{localize 'MCC.Concept.Brief'}}</span>
        <input type="text" data-bind="concept.brief" value="{{concept.brief}}"
               placeholder="{{localize 'MCC.Concept.BriefPlaceholder'}}" {{#if busy}}disabled{{/if}}>
      </label>
      <label class="mcc-field">
        <span>{{localize 'MCC.Concept.PartyLevel'}}</span>
        <input type="number" data-bind="concept.partyLevel" value="{{concept.partyLevel}}"
               min="1" max="20" step="1" {{#if busy}}disabled{{/if}}>
      </label>
      <label class="mcc-field">
        <span>{{localize 'MCC.Concept.PartySize'}}</span>
        <input type="number" data-bind="concept.partySize" value="{{concept.partySize}}"
               min="1" max="10" step="1" {{#if busy}}disabled{{/if}}>
      </label>
      <label class="mcc-field">
        <span>{{localize 'MCC.Concept.Role'}}</span>
        <select data-bind="concept.role" {{#if busy}}disabled{{/if}}>
          {{#each concept.roles}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}} ({{localize 'MCC.Concept.LevelShort'}} {{level}})</option>
          {{/each}}
        </select>
      </label>
    </div>
    <div class="mcc-row mcc-budget">
      <span class="mcc-note" data-tooltip="{{localize 'MCC.Concept.BudgetTooltip'}}">
        <i class="fa-solid fa-scale-balanced"></i>
        {{localize 'MCC.Concept.BudgetLine' xp=concept.xp threat=concept.threat budget=concept.moderateBudget count=concept.fitModerate}}
      </span>
      {{#if concept.busy}}
        <span class="mcc-busy"><i class="fa-solid fa-spinner fa-spin"></i> {{localize 'MCC.Generate.Working'}}</span>
        <button type="button" data-action="cancel">{{localize 'MCC.Generate.Cancel'}}</button>
      {{else}}
        <button type="button" data-action="concept" {{#unless hasApiKey}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
          <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize 'MCC.Concept.Submit'}}
        </button>
      {{/if}}
    </div>
    {{#each concept.corrections}}
      <p class="mcc-warning"><i class="fa-solid fa-wrench"></i> {{this}}</p>
    {{/each}}
  </div>

  <div class="mcc-columns">
    <div class="mcc-column mcc-column-input">
      <h3>{{localize 'MCC.Builder.BasicsHeading'}}
        <i class="fa-solid fa-circle-info" data-tooltip="{{localize 'MCC.Builder.BasicsTooltip'}}"></i>
      </h3>
      <div class="mcc-row">
        <label class="mcc-field mcc-field-wide">
          <span>{{localize 'MCC.Builder.Name'}}</span>
          <input type="text" data-bind="builder.name" value="{{builder.name}}" {{#if busy}}disabled{{/if}}>
        </label>
        <label class="mcc-field">
          <span>{{localize 'MCC.Builder.Level'}}</span>
          <select data-bind="builder.level" {{#if busy}}disabled{{/if}}>
            {{#each builder.level}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>
            {{/each}}
          </select>
        </label>
        <label class="mcc-field">
          <span>{{localize 'MCC.Builder.RoadMap'}}</span>
          <select data-bind="builder.roadMap" {{#if busy}}disabled{{/if}}
                  data-tooltip="{{localize 'MCC.Builder.RoadMapHint'}}">
            {{#each builder.roadMaps}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
      </div>
      <div class="mcc-row">
        <label class="mcc-field">
          <span>{{localize 'MCC.Builder.Size'}}</span>
          <select data-bind="builder.size" {{#if busy}}disabled{{/if}}>
            {{#each builder.sizes}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="mcc-field">
          <span>{{localize 'MCC.Builder.Rarity'}}</span>
          <select data-bind="builder.rarity" {{#if busy}}disabled{{/if}}>
            {{#each builder.rarities}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="mcc-field">
          <span>{{localize 'MCC.Builder.Speed'}}</span>
          <input type="number" data-bind="builder.speed" value="{{builder.speed}}" min="0" step="5"
                 {{#if busy}}disabled{{/if}}>
        </label>
        <label class="mcc-field mcc-field-wide">
          <span>{{localize 'MCC.Builder.Traits'}}</span>
          <input type="text" data-bind="builder.traits" value="{{builder.traits}}"
                 placeholder="{{localize 'MCC.Builder.TraitsPlaceholder'}}" {{#if busy}}disabled{{/if}}>
        </label>
      </div>
      <label class="mcc-field">
        <span>{{localize 'MCC.Builder.Description'}}</span>
        <textarea data-bind="builder.description" rows="2"
                  placeholder="{{localize 'MCC.Builder.DescriptionPlaceholder'}}"
                  {{#if busy}}disabled{{/if}}>{{builder.description}}</textarea>
        <small>{{localize 'MCC.Builder.DescriptionHint'}}</small>
      </label>

      <h3>{{localize 'MCC.Builder.StatsHeading'}}
        <i class="fa-solid fa-circle-info" data-tooltip="{{localize 'MCC.Builder.StatsTooltip'}}"></i>
      </h3>
      <div class="mcc-tier-grid">
        {{#each builder.tiers}}
          <label class="mcc-tier-row">
            <span>{{localize label}}</span>
            <select data-bind="builder.tier.{{key}}" {{#if ../busy}}disabled{{/if}}>
              {{#each options}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            <output>{{value}}</output>
          </label>
        {{/each}}
      </div>

      <h3>{{localize 'MCC.Builder.AbilitiesHeading'}}
        <i class="fa-solid fa-circle-info" data-tooltip="{{localize 'MCC.Builder.AbilitiesTooltip'}}"></i>
      </h3>
      <div class="mcc-tier-grid mcc-ability-grid">
        {{#each builder.abilities}}
          <label class="mcc-tier-row">
            <span>{{label}}</span>
            <select data-bind="builder.ability.{{key}}" {{#if ../busy}}disabled{{/if}}>
              {{#each options}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            <output>{{value}}</output>
          </label>
        {{/each}}
      </div>

      <h3>{{localize 'MCC.Builder.StrikesHeading'}}
        <i class="fa-solid fa-circle-info" data-tooltip="{{localize 'MCC.Builder.StrikesTooltip'}}"></i>
      </h3>
      {{#each builder.strikes}}
        <div class="mcc-row mcc-strike-row">
          <input type="text" data-bind="builder.strike.{{index}}.name" value="{{name}}"
                 placeholder="{{localize 'MCC.Builder.StrikeName'}}" {{#if ../busy}}disabled{{/if}}>
          <label class="mcc-checkbox">
            <input type="checkbox" data-bind="builder.strike.{{index}}.kind"
                   {{#if isRanged}}checked{{/if}} {{#if ../busy}}disabled{{/if}}>
            {{localize 'MCC.Builder.StrikeRanged'}}
          </label>
          <select data-bind="builder.strike.{{index}}.damageType" {{#if ../busy}}disabled{{/if}}>
            {{#each damageTypes}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>
            {{/each}}
          </select>
          <button type="button" data-action="removeStrike" data-index="{{index}}"
                  data-tooltip="{{localize 'MCC.Builder.RemoveStrike'}}" {{#if ../busy}}disabled{{/if}}>
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      {{/each}}
      <button type="button" class="mcc-add" data-action="addStrike" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-plus"></i> {{localize 'MCC.Builder.AddStrike'}}
      </button>

      <h3>{{localize 'MCC.Builder.SkillsHeading'}}
        <i class="fa-solid fa-circle-info" data-tooltip="{{localize 'MCC.Builder.SkillsTooltip'}}"></i>
      </h3>
      {{#each builder.skills}}
        <div class="mcc-row mcc-skill-row">
          <select data-bind="builder.skill.{{index}}.slug" {{#if ../busy}}disabled{{/if}}>
            {{#each options}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>
            {{/each}}
          </select>
          <select data-bind="builder.skill.{{index}}.tier" {{#if ../busy}}disabled{{/if}}>
            {{#each tiers}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          <button type="button" data-action="removeSkill" data-index="{{index}}"
                  data-tooltip="{{localize 'MCC.Builder.RemoveSkill'}}" {{#if ../busy}}disabled{{/if}}>
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      {{/each}}
      <button type="button" class="mcc-add" data-action="addSkill" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-plus"></i> {{localize 'MCC.Builder.AddSkill'}}
      </button>

      <h3>{{localize 'MCC.Drop.Heading'}}
        <i class="fa-solid fa-circle-info" data-tooltip="{{localize 'MCC.Drop.Tooltip'}}"></i>
      </h3>
      <div class="mcc-drop-grid">

        <div class="mcc-drop-zone" data-bucket="spells">
          <h4>{{localize 'MCC.Drop.Bucket.spells'}} ({{builder.spellCount}})</h4>
          <p class="mcc-drop-hint">{{localize 'MCC.Drop.Invite'}}</p>
          <ul class="mcc-drop-list">
            {{#each builder.contents.spells}}
              <li>
                {{#if img}}<img src="{{img}}" alt="">{{/if}}
                <span>{{name}}</span>
                <select data-bind="builder.spellFreq.{{index}}" {{#if ../busy}}disabled{{/if}}>
                  {{#each frequencies}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
                <button type="button" data-action="removeDrop" data-bucket="spells" data-index="{{index}}"
                        data-tooltip="{{localize 'MCC.Drop.Remove'}}"><i class="fa-solid fa-xmark"></i></button>
              </li>
            {{/each}}
          </ul>
        </div>

        <div class="mcc-drop-zone" data-bucket="specials">
          <h4>{{localize 'MCC.Drop.Bucket.specials'}}</h4>
          <p class="mcc-drop-hint">{{localize 'MCC.Drop.Invite'}}</p>
          <ul class="mcc-drop-list">
            {{#each builder.contents.specials}}
              <li>
                {{#if img}}<img src="{{img}}" alt="">{{/if}}
                <span>{{name}}</span>
                <span class="mcc-action-type">[{{actionType}}]</span>
                <button type="button" data-action="removeDrop" data-bucket="specials" data-index="{{index}}"
                        data-tooltip="{{localize 'MCC.Drop.Remove'}}"><i class="fa-solid fa-xmark"></i></button>
              </li>
            {{/each}}
          </ul>
        </div>

        <div class="mcc-drop-zone" data-bucket="gear">
          <h4>{{localize 'MCC.Drop.Bucket.gear'}}</h4>
          <p class="mcc-drop-hint">{{localize 'MCC.Drop.Invite'}}</p>
          <ul class="mcc-drop-list">
            {{#each builder.contents.gear}}
              <li>
                {{#if img}}<img src="{{img}}" alt="">{{/if}}
                <span>{{name}}</span>
                <button type="button" data-action="removeDrop" data-bucket="gear" data-index="{{index}}"
                        data-tooltip="{{localize 'MCC.Drop.Remove'}}"><i class="fa-solid fa-xmark"></i></button>
              </li>
            {{/each}}
          </ul>
          <div class="mcc-row mcc-gear-add">
            <input type="text" data-bind="builder.gearEntry" value="{{builder.gearEntry}}"
                   placeholder="{{localize 'MCC.Drop.GearPlaceholder'}}" {{#if busy}}disabled{{/if}}>
            <button type="button" data-action="addGear" {{#if busy}}disabled{{/if}}>
              <i class="fa-solid fa-plus"></i> {{localize 'MCC.Drop.AddGear'}}
            </button>
          </div>
        </div>

      </div>
    </div>

    <div class="mcc-column mcc-column-preview">
      {{> mccSpecPreview builderSpec}}
    </div>
  </div>

  <div class="mcc-rules">
    {{#each rules.errors}}
      <p class="mcc-error"><i class="fa-solid fa-circle-exclamation"></i> {{this}}</p>
    {{/each}}
    {{#each rules.warnings}}
      <p class="mcc-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>
    {{/each}}
    <p class="mcc-note" data-tooltip="{{localize 'MCC.Rules.ScoreTooltip'}}">
      <i class="fa-solid fa-scale-balanced"></i>
      {{localize 'MCC.Rules.Score' score=rules.score band=rules.band}}
    </p>
  </div>

  <footer class="mcc-footer">
    <label class="mcc-checkbox" data-tooltip="{{localize 'MCC.Create.ArtHint'}}">
      <input type="checkbox" id="mcc-art-builder" data-bind="art.want"
               {{#if wantArt}}checked{{/if}} {{#unless hasApiKey}}disabled{{/unless}}>
      {{localize 'MCC.Create.ArtLabel'}}
    </label>
    {{#if busyCreate}}
      <span class="mcc-busy"><i class="fa-solid fa-spinner fa-spin"></i>
        {{#if busyArtwork}}{{localize 'MCC.Create.PaintingBusy'}}{{else}}{{localize 'MCC.Generate.Working'}}{{/if}}
      </span>
      <button type="button" data-action="cancel">{{localize 'MCC.Generate.Cancel'}}</button>
    {{else}}
      <button type="button" class="mcc-primary" data-action="createBuilder" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-user-plus"></i> {{localize 'MCC.Create.Submit'}}
      </button>
    {{/if}}
  </footer>
</section>
